    {
      "type": "stat",
      "title": "Availability (28d)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": [
          {
            "color": "red",
            "value": null
          },
          {
            "color": "orange",
            "value": 0.99
          },
          {
            "color": "green",
            "value": 0.995
          }
        ],
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(increase(airt_llm_requests_total{status=\"error\"}[28d])) / sum(increase(airt_llm_requests_total[28d])))",
