    {
      "type": "table",
      "title": "Month-to-date showback (ClickHouse)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT team, feature, model, count() AS calls, countIf(cache_hit) AS cache_hits, round(sumIf(cost_usd, NOT cache_hit), 4) AS spend_usd, round(sumIf(cost_usd, cache_hit), 4) AS saved_usd FROM llmops.llm_usage WHERE ts >= toStartOfMonth(now()) GROUP BY team, feature, model ORDER BY spend_usd DESC"
        }
      ],
      "id": 18
    }
